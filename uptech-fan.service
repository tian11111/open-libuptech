[Unit]
Description=OpenLibUptech GPIO18 fan 80-percent PWM output
Requires=pigpiod.service
After=pigpiod.service
ConditionPathExists=/usr/local/bin/pigs

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pigs pfs 18 800
ExecStart=/usr/local/bin/pigs prs 18 100
ExecStart=/usr/local/bin/pigs p 18 80
ExecStop=/usr/local/bin/pigs w 18 0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
