[Unit]
Description=OpenLibUptech GPIO18 fan PWM
Requires=pigpiod.service
After=pigpiod.service
ConditionPathExists=/usr/local/bin/pigs

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pigs hp 18 20000 1000000
ExecStop=/usr/local/bin/pigs hp 18 20000 0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
