[Unit]
Description=OpenLibUptech CPU-temperature GPIO18 fan controller
Requires=pigpiod.service
After=pigpiod.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/uptech_fan_control.py
ExecStop=/usr/local/bin/pigs w 18 0
Restart=on-failure
RestartSec=2
RuntimeDirectory=openlibuptech
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
